    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const btnToggle = document.getElementById('toggleSenha');
        const inputSenha = document.getElementById('senha');
        const iconeSenha = document.getElementById('iconeSenha');

        btnToggle.addEventListener('click', () => {
            const oculto = inputSenha.type === 'password';
            inputSenha.type = oculto ? 'text' : 'password';
            iconeSenha.classList.toggle('bi-eye', !oculto);
            iconeSenha.classList.toggle('bi-eye-slash', oculto);
        });
    </script>
