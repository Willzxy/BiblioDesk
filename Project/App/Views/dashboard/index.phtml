<script>
    document.querySelectorAll('.btn-devolver').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('devolverId').value = btn.dataset.id;
            document.getElementById('devolverUsuario').textContent = btn.dataset.usuario;
            document.getElementById('devolverLivro').textContent = btn.dataset.livro;
        });
    });
</script>

