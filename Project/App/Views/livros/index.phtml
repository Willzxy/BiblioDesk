<script>
    document.querySelectorAll('.btn-editar-livro').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('editLivroId').value = btn.dataset.id;
            document.getElementById('editLivroIsbn').value = btn.dataset.isbn;
            document.getElementById('editLivroTitulo').value = btn.dataset.titulo;
            document.getElementById('editLivroAutor').value = btn.dataset.autor;
            document.getElementById('editLivroCategoria').value = btn.dataset.categoria;
            document.getElementById('editLivroTotal').value = btn.dataset.total;
            document.getElementById('editLivroDisponivel').value = btn.dataset.disponivel;
        });
    });

    document.querySelectorAll('.btn-excluir-livro').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('excluirLivroId').value = btn.dataset.id;
            document.getElementById('excluirLivroTitulo').textContent = btn.dataset.titulo;
        });
    });
</script>

